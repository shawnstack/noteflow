{
  "name": "noteflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NoteFlow —— 三栏 AI 笔记应用：左侧文件管理、中间文本阅读/编辑、右侧 AI 对话。基于 QuickForge 基础能力构建。",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-ai": "^0.80.3",
    "@shawnstack/quickforge": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.11.0",
    "mermaid": "^12.0.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  }
}
